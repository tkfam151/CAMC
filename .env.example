# Copy this file to .env and fill in your Supabase project details.
# Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co

# The "service_role" secret key. Keep it private: it must only ever live on the
# server, never in the browser or in git. (.env is already in .gitignore.)
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# PORT=3000
